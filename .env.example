# FastVid local/deployment environment example.
# Placeholder values only. Never commit real database URLs, Supabase keys, session secrets, or provider keys.

# Frontend public env for apps/web.
# These values are exposed to browser code by Vite and must never contain secrets.
VITE_API_BASE_URL=http://localhost:4000
VITE_SITE_URL=https://fastvid.my.id

# Backend runtime env for apps/api.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
WEB_ORIGIN=https://fastvid.my.id
PUBLIC_API_BASE_URL=http://localhost:4000

# Backend private database/Supabase env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fastvid
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Backend private security env.
# IP_HASH_SECRET: at least 32 random characters.
IP_HASH_SECRET=replace-with-at-least-32-random-characters

# API_KEY_ENCRYPTION_KEY: base64 string that decodes to exactly 32 bytes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ADMIN_SESSION_SECRET: at least 32 random characters.
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Local-only admin workflows. Do not put these in frontend env.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_SMOKE_EMAIL=admin@example.com
ADMIN_SMOKE_PASSWORD=replace-with-local-smoke-password