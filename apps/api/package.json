{
  "name": "@vidsaveid/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test dist/download.test.js dist/admin-auth.test.js dist/supabase-admin-auth-provider.test.js dist/admin-bootstrap.test.js dist/admin-crud.test.js dist/logger/logger.test.js dist/config/cors.test.js dist/providers/providerAdapter.test.js",
    "api:smoke": "tsx --env-file=../../.env src/smoke.ts",
    "admin:bootstrap": "tsx --env-file=../../.env src/scripts/bootstrap-admin.ts",
    "admin:smoke": "tsx --env-file=../../.env src/scripts/admin-auth-smoke.ts",
    "start": "node dist/server.js",
    "start:dev": "node --env-file=../../.env dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@vidsaveid/db": "workspace:*",
    "@vidsaveid/security": "workspace:*",
    "@vidsaveid/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "fastify": "^4.29.0",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vidsaveid/config": "workspace:*",
    "tsx": "^4.19.2"
  }
}
